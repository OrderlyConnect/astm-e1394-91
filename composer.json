{
    "name": "orderlyconnect/astm-e1394-91",
    "description": "Parse, build and transmit ASTM E1394-97 clinical laboratory messages over TCP, serial or files \u2014 including full LLP framing, ENQ/ACK handshake, and a fluent message builder.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "astm",
        "e1394",
        "e1394-97",
        "e1381",
        "laboratory",
        "lis",
        "lims",
        "llp",
        "clinical",
        "haematology",
        "analyser",
        "instrument",
        "hl7"
    ],
    "homepage": "https://github.com/OrderlyConnect/astm-e1394-91",
    "support": {
        "issues": "https://github.com/OrderlyConnect/astm-e1394-91/issues",
        "source": "https://github.com/OrderlyConnect/astm-e1394-91"
    },
    "authors": [
        {
            "name": "OrderlyConnect",
            "homepage": "https://github.com/OrderlyConnect"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Astm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Astm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "check": [
            "@test"
        ],
        "analyse": "phpstan analyse",
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "bin": [
        "bin/astm"
    ]
}
